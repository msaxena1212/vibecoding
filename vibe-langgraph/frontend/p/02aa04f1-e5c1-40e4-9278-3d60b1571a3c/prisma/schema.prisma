generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Shinchan {
  id    Int     @id @default(autoincrement())
  name  String
  age   Int
  likes String?
}

model Doraemon {
  id         Int      @id @default(autoincrement())
  name       String
  gadget     String
  abilities String?
}